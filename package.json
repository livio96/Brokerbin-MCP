{
  "name": "brokerbin-mcp-server",
  "version": "1.0.0",
  "description": "Model Context Protocol server exposing the BrokerBin.com REST API as tools.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "brokerbin-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "dev:http": "MCP_TRANSPORT=http node --watch dist/index.js",
    "lint": "tsc --noEmit",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "express": "^4.21.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  }
}
