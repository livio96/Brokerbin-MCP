# --- Required ---------------------------------------------------------------
# Your BrokerBin REST API bearer token. NEVER commit the real value.
BROKERBIN_API_KEY=your-brokerbin-token-here

# --- Transport --------------------------------------------------------------
# "http" for Render / remote hosting (default), "stdio" for local Claude Desktop/Code.
MCP_TRANSPORT=http
# Port to listen on. Render injects PORT automatically; locally defaults to 3000.
# PORT=3000
# HOST=0.0.0.0

# --- Security (recommended for public hosting) ------------------------------
# If set, clients must send "Authorization: Bearer <this>" to use the server.
# Generate a long random string. Protects your BrokerBin key from anonymous use.
# MCP_AUTH_TOKEN=generate-a-long-random-secret

# --- Optional BrokerBin behavior --------------------------------------------
# Default username to act as when a tool call doesn't specify one.
# BROKERBIN_DEFAULT_LOGIN=
# Override the API base URL (defaults to the production endpoint).
# BROKERBIN_BASE_URL=https://search.brokerbin.com/api/v2

# --- Optional tuning ---------------------------------------------------------
# BROKERBIN_TIMEOUT_MS=30000
# BROKERBIN_MAX_RETRIES=3
# LOG_LEVEL=info   # debug | info | warn | error
